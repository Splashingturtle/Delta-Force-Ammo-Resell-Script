<UserControl x:Class="AmmoResellScript.Views.AutoBuyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:AmmoResellScript.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="600"
             Background="Transparent">

    <Grid Margin="28,20,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 功能卡片 -->
        <Border Grid.Row="0"
                Style="{StaticResource GlassCard}"
                Padding="22,20">
            <StackPanel Orientation="Vertical">

                <!-- 开始扫货按钮 -->
                <Button Content="开始扫货"
                        Command="{Binding StartAutoBuyCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,0,18"/>

                <!-- CheckBox 行 -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,18">
                    <CheckBox IsChecked="{Binding IsBroadcastEnabled}"
                              Style="{StaticResource GlassCheckBox}"
                              Content="开启广播" Margin="0,0,24,0"/>
                    <CheckBox IsChecked="{Binding IsThreeChecked}"
                              Style="{StaticResource GlassCheckBox}"
                              Content="31发检测模式"/>
                </StackPanel>

                <!-- 分隔线 -->
                <Border Height="1" Background="{StaticResource BorderSubtle}"
                        Margin="0,0,0,16"/>

                <!-- 目标价格 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="目标价格"
                               Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Right" Margin="0,0,14,0"/>
                    <TextBox Grid.Column="1"
                             Style="{StaticResource InputBox}"
                             Text="{Binding TargetPrice}"/>
                </Grid>

            </StackPanel>
        </Border>

        <!-- 日志区 -->
        <TextBox Grid.Row="1" Text="{Binding Logs}"
                 Style="{StaticResource LogBox}"
                 helpers:TextBoxHelper.AutoScrollToEnd="True"
                 Margin="0,14,0,0"/>
    </Grid>
</UserControl>
