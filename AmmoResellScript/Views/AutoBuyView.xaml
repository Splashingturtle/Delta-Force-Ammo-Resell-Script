<UserControl x:Class="AmmoResellScript.Views.AutoBuyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:AmmoResellScript.Helpers"
             xmlns:oxy="http://oxyplot.org/wpf"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="600"
             Background="Transparent">

    <Grid x:Name="RootGrid" Margin="28,20,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 功能卡片 -->
        <Border Grid.Row="0"
                Style="{StaticResource GlassCard}"
                Padding="22,20">
            <StackPanel Orientation="Vertical">

                <!-- 按钮行 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="开始扫货"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding StartAutoBuyCommand}"/>
                    <Button Grid.Column="2"
                            Height="36"
                            FontSize="11"
                            Padding="8,0"
                            Command="{Binding ToggleViewCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ConfigButton}">
                                <Setter Property="Content" Value="图表"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChartVisible}" Value="False">
                                        <Setter Property="Content" Value="日志"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="4" Content="清空"
                            Width="52" Height="36"
                            FontSize="11"
                            Style="{StaticResource ConfigButton}"
                            Command="{Binding ClearAllCommand}"/>
                </Grid>

                <!-- 分隔线 -->
                <Border Height="1" Background="{StaticResource BorderSubtle}"
                        Margin="0,0,0,16"/>

                <!-- CheckBox + 定时关机 行 -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsBroadcastEnabled}"
                              Style="{StaticResource GlassCheckBox}"
                              Content="开启广播"/>
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding IsThreeChecked}"
                              Style="{StaticResource GlassCheckBox}"
                              Content="31发检测" Margin="12,0,0,0"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="定时关机"
                                   Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBox Style="{StaticResource InputBox}"
                                 Width="55"
                                 Text="{Binding ShutdownMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="分钟"
                                   Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,4,0"/>
                        <Button Content="开始"
                                Height="30" FontSize="11"
                                Padding="8,0"
                                Style="{StaticResource ConfigButton}"
                                Command="{Binding ScheduleShutdownCommand}"/>
                        <Button Content="取消"
                                Height="30" FontSize="11"
                                Padding="8,0"
                                Style="{StaticResource ConfigButton}"
                                Command="{Binding CancelShutdownCommand}"
                                Margin="2,0,0,0"/>
                        <TextBlock Text="{Binding ShutdownCountdown}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 分隔线 -->
                <Border Height="1" Background="{StaticResource BorderSubtle}"
                        Margin="0,0,0,16"/>

                <!-- 目标价格 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="目标价格"
                               Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Right" Margin="0,0,14,0"/>
                    <TextBox Grid.Column="1"
                             Style="{StaticResource InputBox}"
                             Text="{Binding TargetPrice}"/>
                </Grid>

            </StackPanel>
        </Border>

        <!-- 实时价格走势图表 -->
        <Border x:Name="ChartBorder" Grid.Row="1"
                Padding="8"
                Margin="0,14,0,0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource GlassCard}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChartVisible}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <oxy:PlotView x:Name="ChartView"
                          Background="Transparent"/>
        </Border>

        <!-- 日志区 -->
        <TextBox Grid.Row="1" Text="{Binding Logs}"
                 helpers:TextBoxHelper.AutoScrollToEnd="True"
                 Margin="0,14,0,0">
            <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource LogBox}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChartVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>
    </Grid>
</UserControl>
