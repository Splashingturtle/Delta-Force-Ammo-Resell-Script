<UserControl x:Class="AmmoResellScript.Views.ReceiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:AmmoResellScript.Helpers"
             xmlns:oxy="http://oxyplot.org/wpf"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="600"
             Background="Transparent">

    <Grid x:Name="RootGrid" Margin="28,20,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 功能卡片 -->
        <Border Grid.Row="0"
                Style="{StaticResource GlassCard}"
                Padding="22,16,22,14">

            <StackPanel Orientation="Vertical">

                <!-- 按钮行 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="开始扫货"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding StartReceiveCommand}"/>
                    <Button Grid.Column="2" Content="计算均价"
                            Style="{StaticResource SecondaryButton}"
                            Click="CalcAvgPrice_Click"/>
                    <Button Grid.Column="4"
                            Width="36" Height="36"
                            FontSize="10"
                            Command="{Binding ToggleCalcPanelCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ConfigButton}">
                                <Setter Property="Content" Value="▲"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCalcPanelVisible}" Value="False">
                                        <Setter Property="Content" Value="▼"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="6" Content="清空"
                            Width="52" Height="36"
                            FontSize="11"
                            Style="{StaticResource ConfigButton}"
                            Command="{Binding ClearAllCommand}"/>
                </Grid>

                <!-- 分隔线 -->
                <Border Height="1" Background="{StaticResource BorderSubtle}"
                        Margin="0,0,0,10"/>

                <!-- 价格区间 -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="目标"
                               Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Right" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1"
                             Style="{StaticResource InputBox}"
                             Text="{Binding TargetPrice}"/>
                    <TextBlock Grid.Column="3" Text="最低"
                               Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Right" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="4"
                             Style="{StaticResource InputBox}"
                             Text="{Binding MinPrice}"/>
                </Grid>

                <!-- 可折叠计算字段 -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCalcPanelVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="初始"
                                   Style="{StaticResource FieldLabel}"
                                   HorizontalAlignment="Right" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource InputBox}"
                                 Text="{Binding InitCapital, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Column="3" Text="余额"
                                   Style="{StaticResource FieldLabel}"
                                   HorizontalAlignment="Right" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="4"
                                 Style="{StaticResource InputBox}"
                                 Text="{Binding EndBalance, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="子弹"
                                   Style="{StaticResource FieldLabel}"
                                   HorizontalAlignment="Right" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource InputBox}"
                                 Text="{Binding BulletCount, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Column="3" Text="均价"
                                   Style="{StaticResource FieldLabel}"
                                   HorizontalAlignment="Right" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="4"
                                 Style="{StaticResource ReadOnlyInputBox}"
                                 Text="{Binding AvgPrice}"/>
                    </Grid>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- 实时价格走势图表 -->
        <Border x:Name="ChartBorder" Grid.Row="1"
                Style="{StaticResource GlassCard}"
                Padding="8"
                Margin="0,14,0,0">
            <oxy:PlotView x:Name="ChartView"
                          Background="Transparent"/>
        </Border>

        <!-- 日志区 -->
        <TextBox Grid.Row="2" Text="{Binding Logs}"
                 Style="{StaticResource LogBox}"
                 helpers:TextBoxHelper.AutoScrollToEnd="True"
                 Margin="0,14,0,0"/>
    </Grid>
</UserControl>
