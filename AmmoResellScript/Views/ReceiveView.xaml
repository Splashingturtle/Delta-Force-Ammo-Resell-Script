<UserControl x:Class="AmmoResellScript.Views.ReceiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:AmmoResellScript.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="600"
             Background="Transparent">

    <Grid Margin="28,20,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 功能卡片 -->
        <Border Grid.Row="0"
                Style="{StaticResource GlassCard}"
                Padding="22,20,22,16">

            <StackPanel Orientation="Vertical">

                <!-- 按钮行 -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="开始扫货"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding StartReceiveCommand}"/>
                    <Button Grid.Column="2" Content="计算平均价格"
                            Style="{StaticResource SecondaryButton}"
                            Click="CalcAvgPrice_Click"/>
                </Grid>

                <!-- 分隔线 -->
                <Border Height="1" Background="{StaticResource BorderSubtle}"
                        Margin="0,0,0,14"/>

                <!-- 目标价格 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="目标价格"
                               Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Right" Margin="0,0,14,0"/>
                    <TextBox Grid.Column="1"
                             Style="{StaticResource InputBox}"
                             Text="{Binding TargetPrice}"/>
                </Grid>

                <!-- 初始资金 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="初始资金"
                               Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Right" Margin="0,0,14,0"/>
                    <TextBox Grid.Column="1"
                             Style="{StaticResource InputBox}"
                             Text="{Binding InitCapital, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <!-- 结束余额 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="结束余额"
                               Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Right" Margin="0,0,14,0"/>
                    <TextBox Grid.Column="1"
                             Style="{StaticResource InputBox}"
                             Text="{Binding EndBalance, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <!-- 子弹总数 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="子弹总数"
                               Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Right" Margin="0,0,14,0"/>
                    <TextBox Grid.Column="1"
                             Style="{StaticResource InputBox}"
                             Text="{Binding BulletCount, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <!-- 平均价格 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="平均价格"
                               Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Right" Margin="0,0,14,0"/>
                    <TextBox Grid.Column="1"
                             Style="{StaticResource ReadOnlyInputBox}"
                             Text="{Binding AvgPrice}"/>
                </Grid>

            </StackPanel>
        </Border>

        <!-- 日志区 -->
        <TextBox Grid.Row="1" Text="{Binding Logs}"
                 Style="{StaticResource LogBox}"
                 helpers:TextBoxHelper.AutoScrollToEnd="True"
                 Margin="0,14,0,0"/>
    </Grid>
</UserControl>
