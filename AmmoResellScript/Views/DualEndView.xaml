<UserControl x:Class="AmmoResellScript.Views.DualEndView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:AmmoResellScript.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="600"
             Background="Transparent">

    <Grid Margin="28,20,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 功能卡片 -->
        <Border Grid.Row="0"
                Style="{StaticResource GlassCard}"
                Padding="22,16,22,14">

            <StackPanel Orientation="Vertical">

                <!-- 小窗购买按钮 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="小窗购买"
                               Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="绑定"
                            Style="{StaticResource ConfigButton}"
                            HorizontalAlignment="Left"
                            Width="72"
                            Command="{Binding BindSmallWindowBuyCommand}"/>
                </Grid>

                <!-- 分隔线 -->
                <Border Height="1" Background="{StaticResource BorderSubtle}"
                        Margin="0,0,0,12"/>

                <!-- 目标价格 + 广播 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="目标价格"
                               Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding TargetPrice}"
                                 Width="140"/>
                        <CheckBox IsChecked="{Binding IsBroadcastEnabled}"
                                  Style="{StaticResource GlassCheckBox}"
                                  Content="广播"
                                  Margin="16,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 开始按钮 -->
                <Button Content="开始"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding StartCommand}"/>

            </StackPanel>
        </Border>

        <!-- 日志区 -->
        <TextBox Grid.Row="1" Text="{Binding Logs}"
                 Style="{StaticResource LogBox}"
                 helpers:TextBoxHelper.AutoScrollToEnd="True"
                 Margin="0,14,0,0"/>
    </Grid>
</UserControl>
