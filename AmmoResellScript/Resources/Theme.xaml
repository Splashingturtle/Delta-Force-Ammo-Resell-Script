<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:AmmoResellScript.ViewModels"
                    xmlns:views="clr-namespace:AmmoResellScript.Views">

    <!-- ═══════════════════════════════════════════ -->
    <!-- 深色毛玻璃 · 极简科技风 · 通透磨砂质感              -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- ── 高对比度文字 ── -->
    <SolidColorBrush x:Key="TextPrimary" Color="#E8ECF2"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#B0BCD0"/>
    <SolidColorBrush x:Key="TextMuted" Color="#6E8098"/>
    <SolidColorBrush x:Key="AccentColor" Color="#1E3959"/>
    <SolidColorBrush x:Key="AccentHoverColor" Color="#2A4D78"/>
    <SolidColorBrush x:Key="AccentSelectedNavBg" Color="#AA1E3959"/>
    <!-- 勾选框鲜艳蓝 -->
    <SolidColorBrush x:Key="CheckAccentColor" Color="#4D9EFF"/>
    <!-- 按钮浅蓝高透 -->
    <SolidColorBrush x:Key="GlassAccentBg" Color="#403390FF"/>
    <SolidColorBrush x:Key="GlassAccentHover" Color="#604DA6FF"/>
    <SolidColorBrush x:Key="GlassAccentPressed" Color="#302280CC"/>
    <SolidColorBrush x:Key="GreenColor" Color="#6BAF8A"/>
    <SolidColorBrush x:Key="GreenHoverColor" Color="#82C4A0"/>
    <SolidColorBrush x:Key="RedColor" Color="#C07878"/>
    <SolidColorBrush x:Key="RedHoverColor" Color="#D09090"/>

    <!-- ── 深色毛玻璃表面（高透 → 低透层级） ── -->
    <SolidColorBrush x:Key="GlassSurface"      Color="#601C212A"/>
    <SolidColorBrush x:Key="GlassSurfaceAlt"   Color="#481C212A"/>
    <SolidColorBrush x:Key="GlassInputBg"      Color="#3A1A1E26"/>
    <SolidColorBrush x:Key="GlassButtonBg"     Color="#4A202632"/>
    <SolidColorBrush x:Key="GlassButtonHover"  Color="#7028303C"/>
    <SolidColorBrush x:Key="GlassButtonPressed" Color="#301A1E26"/>
    <SolidColorBrush x:Key="GlassLogBg"        Color="#551E2430"/>
    <SolidColorBrush x:Key="GlassNavBg"        Color="#441A1F2A"/>
    <SolidColorBrush x:Key="GlassTitleBarBg"   Color="#38161B24"/>

    <!-- ── 白色高光描边（极细哑光） ── -->
    <SolidColorBrush x:Key="BorderHighlight"   Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="BorderMedium"      Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="BorderFocus"       Color="#551E3959"/>
    <SolidColorBrush x:Key="BorderSubtle"      Color="#0DFFFFFF"/>

    <!-- ── 内发光 ── -->
    <SolidColorBrush x:Key="InnerGlow"         Color="#08FFFFFF"/>

    <!-- ── 悬浮投影 ── -->
    <DropShadowEffect x:Key="CardShadow"       BlurRadius="20" ShadowDepth="2" Direction="270"
                      Opacity="0.25" Color="#000000"/>
    <DropShadowEffect x:Key="CardShadowHover"   BlurRadius="28" ShadowDepth="4" Direction="270"
                      Opacity="0.35" Color="#000000"/>
    <DropShadowEffect x:Key="ButtonShadow"      BlurRadius="8"  ShadowDepth="1" Direction="270"
                      Opacity="0.18" Color="#000000"/>
    <DropShadowEffect x:Key="NavShadow"         BlurRadius="6"  ShadowDepth="1" Direction="270"
                      Opacity="0.12" Color="#000000"/>

    <!-- ═══════════════════ 通用玻璃卡片 ═══════════════════ -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderHighlight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ═══════════════════ 导航标签按钮 ═══════════════════ -->
    <Style x:Key="NavTabButton" TargetType="RadioButton">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="72"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="TabBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="16,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentSelectedNavBg}"/>
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource BorderHighlight}"/>
                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="1"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════ 主按钮（浅蓝高透玻璃） ═══════════════════ -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="44"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="{StaticResource GlassAccentBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderHighlight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Effect" Value="{StaticResource ButtonShadow}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            SnapsToDevicePixels="True">
                        <!-- 顶部高光 -->
                        <Border CornerRadius="12"
                                BorderBrush="#25FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="24,0"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassAccentHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CheckAccentColor}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassAccentPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════ 次按钮（深色玻璃） ═══════════════════ -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Height" Value="44"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource GlassButtonBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderMedium}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Effect" Value="{StaticResource ButtonShadow}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="24,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassButtonHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderFocus}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassButtonPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════ 保存按钮 ═══════════════════ -->
    <Style x:Key="SaveButton" TargetType="Button">
        <Setter Property="Height" Value="42"/>
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="{StaticResource GreenColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Effect" Value="{StaticResource ButtonShadow}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12"
                            SnapsToDevicePixels="True">
                        <Border CornerRadius="12" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="20,0"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GreenHoverColor}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#5A9870"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════ 配置绑定按钮 ═══════════════════ -->
    <Style x:Key="ConfigButton" TargetType="Button">
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Background" Value="{StaticResource GlassInputBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderHighlight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="12,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassButtonHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderFocus}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassButtonPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════ 通用输入框 ═══════════════════ -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Height" Value="42"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource GlassInputBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderMedium}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource CheckAccentColor}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            SnapsToDevicePixels="True">
                        <!-- 内凹高光 -->
                        <Border CornerRadius="12" BorderBrush="{StaticResource InnerGlow}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="14,0"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderFocus}"/>
                            <Setter TargetName="Bd" Property="Background" Value="#70202632"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderMedium}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════ 小号输入框 ═══════════════════ -->
    <Style x:Key="SmallInputBox" TargetType="TextBox">
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource GlassInputBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderMedium}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource CheckAccentColor}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="10,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderFocus}"/>
                            <Setter TargetName="Bd" Property="Background" Value="#70202632"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════ 只读展示框 ═══════════════════ -->
    <Style x:Key="ReadOnlyInputBox" TargetType="TextBox">
        <Setter Property="Height" Value="42"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource CheckAccentColor}"/>
        <Setter Property="Background" Value="{StaticResource GlassSurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderMedium}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="14,0"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════ 字段标签 ═══════════════════ -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ═══════════════════ 日志输出面板 ═══════════════════ -->
    <Style x:Key="LogBox" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Background" Value="{StaticResource GlassLogBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderHighlight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="CaretBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            SnapsToDevicePixels="True">
                        <!-- 内发光边 -->
                        <Border CornerRadius="12" BorderBrush="{StaticResource InnerGlow}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0"/>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════ CheckBox ═══════════════════ -->
    <Style x:Key="GlassCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Background="Transparent" Padding="4,2">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBorder"
                                    Width="18" Height="18"
                                    Background="{StaticResource GlassInputBg}"
                                    BorderBrush="{StaticResource BorderMedium}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    SnapsToDevicePixels="True"
                                    Margin="0,0,8,0">
                                <Path x:Name="CheckMark"
                                      Data="M4,9 L7,12 L14,5"
                                      Stroke="{StaticResource CheckAccentColor}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform"
                                      Margin="2"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource GlassSurface}"/>
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource CheckAccentColor}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource BorderFocus}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════ ScrollBar ═══════════════════ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource BorderMedium}"
                                                    CornerRadius="3"
                                                    SnapsToDevicePixels="True"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════ DataTemplates ═══════════════════ -->
    <DataTemplate DataType="{x:Type vm:AutoBuyViewModel}">
        <views:AutoBuyView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReceiveViewModel}">
        <views:ReceiveView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingViewModel}">
        <views:SettingView/>
    </DataTemplate>

</ResourceDictionary>
