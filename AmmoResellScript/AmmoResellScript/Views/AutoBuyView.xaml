<UserControl x:Class="AmmoResellScript.Views.AutoBuyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AmmoResellScript.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="2.5*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Vertical" VerticalAlignment="Center">
            <Button Content="开始扫货" Command="{Binding StartAutoBuyCommand}" Margin="10" Style="{StaticResource StartButton}" Height="60"/>
            
            <StackPanel Orientation="Horizontal" Margin="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                <CheckBox IsChecked="{Binding IsBroadcastEnabled}" Foreground="White" Content="开启广播" Margin="0,0,10,0" FontSize="14"/>
                <CheckBox IsChecked="{Binding IsThreeChecked}" Foreground="White" Content="31发检测模式" Margin="10,0,0,0" FontSize="14"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5">
                <TextBlock VerticalAlignment="Bottom" Height="40" Foreground="White" FontSize="14" Margin="0,0,10,0">
                    目标价格:
                </TextBlock>
                <TextBox Text="{Binding TargetPrice}" Style="{StaticResource CommonTextBoxStyle}" Height="50" Width="200"/>
            </StackPanel>
        </StackPanel>
        <TextBox Grid.Row="1" Text="{Binding Logs}" Style="{StaticResource TextBoxStyle}" Width="400" IsReadOnly="True"/>
    </Grid>
</UserControl>
