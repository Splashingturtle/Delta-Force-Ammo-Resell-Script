<UserControl x:Class="AmmoResellScript.Views.ReceiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AmmoResellScript.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="开始扫货" Command="{Binding StartReceiveCommand}" Margin="10" Style="{StaticResource StartButton}" Height="60"/>
        <TextBox Grid.Row="2" Text="{Binding Logs}" Style="{StaticResource TextBoxStyle}" Width="400" IsReadOnly="True"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5">
            <TextBlock VerticalAlignment="Bottom" Height="40" Foreground="White" FontSize="14" Margin="0,0,10,0">
                    目标价格:
            </TextBlock>
            <TextBox Style="{StaticResource CommonTextBoxStyle}" Height="50" Width="200" Text="{Binding TargetPrice}"/>
        </StackPanel>
    </Grid>
</UserControl>
