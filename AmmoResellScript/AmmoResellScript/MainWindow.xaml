<Window x:Class="AmmoResellScript.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AmmoResellScript"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="400"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2A"
        xmlns:UserControls="clr-namespace:AmmoResellScript.UserControls"
        Icon="/images/1.jpg">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="9.5*"/>
        </Grid.RowDefinitions>

        <UserControls:Navigation Grid.Row="0" Margin="0,6,0,0"/>

        <ContentControl Grid.Row="1" Content="{Binding MainContent}"/>

    </Grid>
</Window>
